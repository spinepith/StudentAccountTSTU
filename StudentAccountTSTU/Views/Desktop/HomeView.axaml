<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:StudentAccountTSTU.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:svg="clr-namespace:Svg.Controls.Skia.Avalonia"
             x:Class="StudentAccountTSTU.Views.Desktop.HomeView"
             x:DataType="vm:HomeViewModel">
  
    <Border Background="#10FFFFFF" CornerRadius="28" ClipToBounds="True" Padding="4">
        <Grid ColumnDefinitions="2*, *" ColumnSpacing="4">
            
            <Grid Grid.Column="0" RowDefinitions="*, *" RowSpacing="4">
                    
                <Grid Grid.Row="0" ColumnDefinitions="2*, *" ColumnSpacing="4">
                    
                    <Border Grid.Column="0" Background="#20FFFFFF" CornerRadius="24" ClipToBounds="True">                      
                        <Panel VerticalAlignment="Stretch">
                            <Label Content="ЛИЧНЫЕ ДАННЫЕ" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsVisible="True"/>
                        </Panel>
                    </Border>

                    <Border Grid.Column="1" Background="#20FFFFFF" CornerRadius="24" ClipToBounds="True">                      
                        <Panel VerticalAlignment="Stretch">
                            <Label Content="РЕЙТИНГ" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsVisible="True"/>
                        </Panel>
                    </Border>
                    
                </Grid>

                <Border Grid.Row="1" Background="#20FFFFFF" CornerRadius="24" ClipToBounds="True">
                    <Panel VerticalAlignment="Stretch">
                        <Label Content="РАСПИСАНИЕ" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsVisible="True"/>
                    </Panel>
                </Border>

            </Grid>

            <Border Grid.Column="1" Background="#20FFFFFF" CornerRadius="24" ClipToBounds="True">
                <Panel VerticalAlignment="Stretch">
                    <Label Content="БАЛЛЫ" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsVisible="True"/>                        
                </Panel>
            </Border>
            
        </Grid>
    </Border>

</UserControl>
