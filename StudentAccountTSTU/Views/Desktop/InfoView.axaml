<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lotie="using:Avalonia.Labs.Lottie"
             xmlns:vm="using:StudentAccountTSTU.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="StudentAccountTSTU.Views.Desktop.InfoView"
             x:DataType="vm:InfoViewModel">

    <Grid RowDefinitions="*, Auto" RowSpacing="4">

        <Border Grid.Row="0"
                Background="#10FFFFFF"
                CornerRadius="28"
                Padding="4"
                ClipToBounds="True"
                IsVisible="{CompiledBinding CurrentPage, Converter={x:Static ObjectConverters.IsNull}}">
            <Border BorderBrush="White" BorderThickness="2" CornerRadius="24">
                <Grid RowDefinitions="*, *, *" RowSpacing="8">

                    <Svg Grid.Row="0" Path="/Assets/logo-white.svg" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Text="{CompiledBinding Description}"/>

                    <TextBlock Grid.Row="2"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Text="{CompiledBinding Author}"/>

                </Grid>
            </Border>
        </Border>

        <Button Grid.Row="1" MinHeight="48" Content="НАЗАД" Command="{CompiledBinding BackToHomeCommand}"/>

    </Grid>

</UserControl>
