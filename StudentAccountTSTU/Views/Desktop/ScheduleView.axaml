<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="StudentAccountTSTU.Views.Desktop.ScheduleView">

    <Border Background="#10FFFFFF" CornerRadius="28" ClipToBounds="True" Padding="4">
        <Grid ColumnDefinitions="*, *" ColumnSpacing="4">
            
           <Border Grid.Column="0" Background="#20FFFFFF" CornerRadius="24" ClipToBounds="True">                      
                <Panel VerticalAlignment="Stretch">
                    <Label Content="НЕЧЕТНАЯ НЕДЕЛЯ" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsVisible="True"/>
                </Panel>
            </Border>
           
            <Border Grid.Column="1" Background="#20FFFFFF" CornerRadius="24" ClipToBounds="True">                      
                <Panel VerticalAlignment="Stretch">
                    <Label Content="ЧЕТНАЯ НЕДЕЛЯ" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsVisible="True"/>
                </Panel>
            </Border>

        </Grid>
    </Border>

</UserControl>
